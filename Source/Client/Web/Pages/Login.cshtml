@page
@model BigCommerceApi.Client.Web.Pages.LoginModel

<!DOCTYPE html>
<html class="h-100" lang="hr">

<head>
    <meta charset="utf-8">
    <title>Monri BigC Administration</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Thank you!">
    <link rel="apple-touch-icon" sizes="180x180" href="assets/icons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="assets/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="192x192" href="assets/icons/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="16x16" href="assets/icons/favicon-16x16.png">
    <link rel="manifest" href="site.webmanifest">
    <link rel="mask-icon" href="assets/icons/safari-pinned-tab.svg" color="#5bbad5">
    <link rel="shortcut icon" href="assets/icons/favicon.ico">
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@700,500,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="assets/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="assets/css/theme.css">
</head>

<body class="login-page h-100">
    <main class="d-flex align-items-center justify-content-center h-100">
        <div class="card">
            <div class="card-body">
                <div class="text-center">
                    <h1 class="mt-0 mb-3"><strong class="text-gradient">Login</strong></h1>
                </div>
                <form class="mx-auto needs-validation" method="post" novalidate>
                    <div class="mb-2">
                        <label for="Username" class="form-label d-block small text-uppercase mb-1 ps-1">Username</label>
                        <div class="input-group">
                            <input type="text" class="form-control rounded-end-0" id="username" name="username" required>
                            <span class="input-group-text bg-white border-start-0 text-danger required"></span>
                            <div class="invalid-feedback ps-1 small">This field is required!</div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label for="Password" class="form-label d-block small text-uppercase mb-1 ps-1">Password</label>
                        <div class="input-group">
                            <input type="text" class="form-control rounded-end-0" id="password" name="password" required>
                            <span class="input-group-text bg-white border-start-0 text-danger required"></span>
                            <div class="invalid-feedback ps-1 small">This field is required!</div>
                        </div>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-lg btn-primary" asp-page-handler="Submit">Login</button>
                    </div>
                </form>
            </div>
        </div>
    </main>
    <script>
        (() => {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
</body>

</html>
